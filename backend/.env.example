# Copy to backend/.env and fill in. .env is gitignored — never commit real keys.

# Portkey gateway (OpenAI-compatible). Key comes from the course.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
LLM_MODEL=gpt-6-luna

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Lecture 8: Supabase Postgres connection string.
# SUPABASE_DB_URL=

# gpt-6-luna rejects function tools unless this is "none"
LLM_REASONING_EFFORT=none
